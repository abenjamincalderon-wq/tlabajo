---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto">
    <div class="contact-wrapper">
        <h1>Contáctanos</h1>
        <p>¿Tienes dudas sobre qué procesador Ryzen elegir?</p>

        <form class="ryzen-form" onsubmit="event.preventDefault();">
            <label for="name">Nombre</label>
            <input type="text" id="name" placeholder="Tu nombre" required />

            <label for="email">Correo Electrónico</label>
            <input
                type="email"
                id="email"
                placeholder="usuario@ejemplo.com"
                required
            />

            <label for="model">Procesador de interés</label>
            <select id="model">
                <option value="r3">Ryzen 3</option>
                <option value="r5">Ryzen 5</option>
                <option value="r7">Ryzen 7</option>
                <option value="r9">Ryzen 9</option>
            </select>

            <label for="message">Mensaje</label>
            <textarea id="message" rows="4" placeholder="Escribe tu consulta..."
            ></textarea>

            <button type="submit">Enviar Mensaje</button>
        </form>
    </div>
</Layout>

<style>
    /* Estilos específicos de Contacto */
    .contact-wrapper {
        max-width: 550px;
        margin: 0 auto;
        background-color: var(--card-bg);
        padding: 2.5rem;
        border-radius: 12px;
        border: 1px solid #2a2e39;
    }

    .contact-wrapper h1 {
        color: var(--ryzen-orange);
        margin-bottom: 0.5rem;
    }

    .contact-wrapper p {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
    }

    .ryzen-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .ryzen-form label {
        font-size: 0.9rem;
        font-weight: 600;
    }

    .ryzen-form input,
    .ryzen-form select,
    .ryzen-form textarea {
        background-color: var(--dark-bg);
        border: 1px solid #374151;
        color: var(--text-light);
        padding: 0.75rem;
        border-radius: 6px;
        font-family: inherit;
    }

    .ryzen-form button {
        background: linear-gradient(
            45deg,
            var(--ryzen-orange),
            var(--ryzen-red)
        );
        color: white;
        border: none;
        padding: 0.9rem;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        margin-top: 0.5rem;
    }

    .ryzen-form button:hover {
        opacity: 0.9;
    }
</style>
